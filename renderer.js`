if (btnUp) btnUp.onclick = () => { currentTranspose++; renderSong(); };
if (btnDown) btnDown.onclick = () => { currentTranspose--; renderSong(); };

if (btnAddManual) {
    btnAddManual.onclick = () => {
        modalSong.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    };
}

const closeModal = () => {
    if (modalSong) modalSong.classList.add('hidden');
    document.body.style.overflow = 'auto';
    isEditing = false;
    currentSongId = null;
    const modalTitle = document.querySelector('#modal-song h3');
    if (modalTitle) modalTitle.innerText = 'Nueva Canción';
    if (btnSaveManual) btnSaveManual.innerText = 'Guardar Canción';
    if (inputArtist) inputArtist.value = '';
    if (inputTitle) inputTitle.value = '';
    if (inputKey) inputKey.value = '';
    if (inputContent) inputContent.value = '';
};

if (btnCloseModal) btnCloseModal.onclick = closeModal;
if (btnCancelModal) btnCancelModal.onclick = closeModal;

if (btnSaveManual) {
    btnSaveManual.onclick = async () => {
        const songData = {
            artist: inputArtist.value.trim(),
            title: inputTitle.value.trim(),
            key: inputKey.value.trim(),
            content: inputContent.value.trim()
        };
        if (!songData.artist || !songData.title || !songData.content) {
            alert("Por favor, completa los campos obligatorios.");
            return;
        }
        if (isEditing) {
            songData.id = currentSongId;
            await dbBrowser.saveSong(songData);
        } else {
            await dbBrowser.saveSong(songData);
        }
        closeModal();
        loadAllSongs();
    };
}

if (btnEditCurrent) {
    btnEditCurrent.onclick = () => {
        if (!currentSong) return alert("Selecciona una canción primero");
        isEditing = true;
        currentSongId = currentSong.id;
        inputArtist.value = currentSong.artist;
        inputTitle.value = currentSong.title;
        inputKey.value = currentSong.original_key || '';
        inputContent.value = currentSong.content;
        document.querySelector('#modal-song h3').innerText = 'Editar Canción';
        btnSaveManual.innerText = 'Actualizar Cambios';
        modalSong.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    };
}

if (btnBackup) {
    btnBackup.onclick = async () => {
        try {
            const data = await dbBrowser.exportDatabase();
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `chordx_backup_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);
            alert("Respaldo creado con éxito");
        } catch (err) {
            console.error(err);
            alert("Error al crear el respaldo");
        }
    };
}

if (btnRestore) {
    btnRestore.onclick = async () => {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.json';
        input.onchange = async (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async (event) => {
                try {
                    const data = JSON.parse(event.target.result);
                    if (confirm("Se borrarán todas las canciones actuales para cargar el respaldo. ¿Continuar?")) {
                        await dbBrowser.importDatabase(data);
                        loadAllSongs();
                        loadSetlists();
                        alert("Datos restaurados correctamente");
                    }
                } catch (err) {
                    console.error(err);
                    alert("Error al cargar el archivo de respaldo. Asegúrate de que sea un archivo JSON válido de ChordX.");
                }
            };
            reader.readAsText(file);
        };
        input.click();
    };
}
